// ============================================================
// Apple-grade 设计 token -- 由 scripts/inject.js 通过 shokax 的
// theme_inject filter 注入 injects.variable,在 app.styl 中
// `for $v in hexo-config('injects.variable') @import $v` 处被 @import,进 CSS 编译。
// 阶段 A:动效/间距/圆角/阴影 token + 全局无障碍降级(配色重做留待阶段 E)
// ============================================================

:root {
  // -- 缓动曲线(苹果体系) --
  --ease-apple: cubic-bezier(.4, 0, .2, 1);       // 标准:进出对称
  --ease-out-expo: cubic-bezier(.16, 1, .3, 1);   // 入场:快出慢停
  --ease-in-expo: cubic-bezier(.7, 0, .84, 0);    // 退场:慢起快进
  --ease-spring: cubic-bezier(.34, 1.56, .64, 1); // 弹性微回弹
  --ease-soft: cubic-bezier(.25, .1, .25, 1);     // 柔和

  // -- 时长 --
  --duration-instant: 0s;
  --duration-fast: .15s;
  --duration-base: .3s;
  --duration-slow: .6s;
  --duration-slower: 1s;
  --duration-page: .4s; // 页面切换过渡(View Transitions)

  // -- 间距(4px 基数) --
  --space-0: 0;
  --space-1: .25rem;   // 4
  --space-2: .5rem;     // 8
  --space-3: .75rem;    // 12
  --space-4: 1rem;      // 16
  --space-5: 1.5rem;    // 24
  --space-6: 2rem;      // 32
  --space-7: 3rem;      // 48
  --space-8: 4rem;      // 64

  // -- 圆角 --
  --radius-sm: .375rem;
  --radius-md: .625rem;
  --radius-lg: 1rem;
  --radius-xl: 1.5rem;
  --radius-pill: 999px;

  // -- 阴影(多层柔和,取代单一 --box-bg-shadow) --
  --shadow-sm: 0 1px 2px rgba(0,0,0,.04), 0 1px 3px rgba(0,0,0,.06);
  --shadow-md: 0 4px 12px rgba(0,0,0,.08), 0 2px 4px rgba(0,0,0,.04);
  --shadow-lg: 0 12px 32px rgba(0,0,0,.10), 0 4px 12px rgba(0,0,0,.06);
  --shadow-xl: 0 24px 64px rgba(0,0,0,.14), 0 8px 24px rgba(0,0,0,.08);

  // -- 字号模块化尺度(1.250 major third) --
  --step-0: 1rem;
  --step-1: 1.25rem;
  --step-2: 1.5625rem;
  --step-3: 1.953rem;
  --step-4: 2.441rem;
  --step-5: 3.052rem;
}

// ============================================================
// 无障碍:尊重 prefers-reduced-motion,全局降级
// Lenis / View Transitions / scroll-driven 动画在各脚本与样式中另作局部判断
// ============================================================
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
